# Application
APP_ENV=dev
SECRET_KEY=change-me-to-a-long-random-string-in-production
AUTH_ENABLED=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=nehant123
TOKEN_EXPIRE_MINUTES=720

# Database
DATABASE_URL=sqlite:///./data/attendance.sqlite3

# Storage
DATA_DIR=./data
MAX_UPLOAD_MB=25

# Detector: pretrained | finetuned
DETECTOR=pretrained
FINETUNED_MODEL_PATH=models/face_ft_best.onnx

# InsightFace
INSIGHTFACE_MODEL=scrfd_34gf_r100
INSIGHTFACE_HOME=~/.insightface

# Detection settings
DET_SIZE=640
DET_CONF_MIN=0.40
MIN_FACE_PX=40

# Matching thresholds
SIM_ACCEPT=0.45
SIM_REVIEW_MIN=0.35
MARGIN_MIN=0.05

# Enrollment settings
ENROLL_MIN_PHOTOS=3
ENROLL_MAX_PHOTOS=15
ENROLL_MIN_FACE_PX=80
ENROLL_MIN_DET_SCORE=0.60
ENROLL_MIN_BLUR_VAR=60
ENROLL_DUPLICATE_SIM=0.60

# Optional features
TILING=false

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Testing only: skip loading ML models at startup (leave false in normal use)
SKIP_MODEL_LOAD=false
